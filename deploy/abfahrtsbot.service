[Unit]
Description=Abfahrtsbot (Telegram)
After=network-online.target
Wants=network-online.target

[Service]
User=abfahrtsbot
Group=abfahrtsbot
WorkingDirectory=/opt/abfahrtsbot
# Besitzer: BOT_OWNER_ID per Environment= oder EnvironmentFile= setzen, z. B. Environment=BOT_OWNER_ID=123456789.
# Alternativ "owner_id" in config.json (die Umgebungsvariable hat Vorrang). Verwalter ernennt der Besitzer im Bot.
ExecStart=/usr/bin/python3 /opt/abfahrtsbot/abfahrtsbot.py
Restart=always
RestartSec=10
# Härtung: eigener Benutzer, nur /opt/abfahrtsbot beschreibbar
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/abfahrtsbot

[Install]
WantedBy=multi-user.target
