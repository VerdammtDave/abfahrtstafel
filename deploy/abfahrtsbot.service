[Unit]
Description=Abfahrtsbot (Telegram)
After=network-online.target
Wants=network-online.target

[Service]
User=abfahrtsbot
Group=abfahrtsbot
WorkingDirectory=/opt/abfahrtsbot
# Verwalter (Betreiber des Servers): VERWALTER_ID und BOT_OWNER_ID per Environment= oder EnvironmentFile= setzen,
# z. B. Environment=VERWALTER_ID=123456789. Alternativ "verwalter_id" in config.json (die Umgebungsvariable hat Vorrang).
ExecStart=/usr/bin/python3 /opt/abfahrtsbot/abfahrtsbot.py
Restart=always
RestartSec=10
# Härtung: eigener Benutzer, nur /opt/abfahrtsbot beschreibbar
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/abfahrtsbot

[Install]
WantedBy=multi-user.target
