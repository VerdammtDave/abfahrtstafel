# Nach /etc/caddy/Caddyfile kopieren.
# Standard: nur lokal auf Port 8080 (HTTPS macht dann z. B. Tailscale Funnel).
# Mit eigener Domain und Portfreigabe die erste Zeile durch die Adresse ersetzen, z. B. abfahrten.example.de {
:8080 {
	# Nur mit Bot: /api an die Bot-API weiterleiten. Ohne Bot diesen Block löschen.
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy 127.0.0.1:8787
	}
	handle {
		root * /var/www/bahnhofstafel
		file_server
	}
	# Nicht erreichbar: freundliche Seite statt der nackten Fehlermeldung
	handle_errors {
		@down expression {err.status_code} in [502, 503, 504]
		handle @down {
			root * /var/www/bahnhofstafel
			rewrite * /503.html
			file_server
		}
	}
}
